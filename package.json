{
  "name": "pi-multi-model-router",
  "version": "0.1.0",
  "description": "Pi extension: virtual models that route each turn to a physical model via the Jev classifier",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teknologist/pi-multi-model-router.git"
  },
  "homepage": "https://github.com/teknologist/pi-multi-model-router#readme",
  "bugs": {
    "url": "https://github.com/teknologist/pi-multi-model-router/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "llm-router",
    "model-routing"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src/config.ts",
    "src/router.ts",
    "src/usage.ts",
    "examples/config.toml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "evaluate:live": "node --experimental-strip-types scripts/evaluate-live.ts",
    "test:prerequisites": "node --experimental-strip-types --test tests/native-prerequisites.test.ts"
  },
  "dependencies": {
    "smol-toml": "1.9.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.5.0",
    "@earendil-works/pi-coding-agent": ">=1.5.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "22.19.0",
    "typescript": "7.0.2"
  }
}
